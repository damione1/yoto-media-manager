      "delete": {
        "tags": [
          "Family Library Groups"
        ],
        "summary": "delete a group",
        "description": "Delete a group for a family.\n\n- The contextual family is the authorised user's family\n- Groups can only be deleted if a family owns them\n    - If it does not exist a 404 is returned\n    - If it exists but is owned by another family, a 404 is returned\n- Groups are hard-deleted (once deleted, cannot be recovered)\n- Deleting a group does not remove content from the family library. Only the group and content references are removed.\n\n#### Required Scope\n\n`family:library:manage`",
        "operationId": "deleteAGroup",
        "responses": {
          "200": {
            "description": "200 OK",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "example": "30"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "jBakRtwbXA15ABQjVnBxo"
                    }
                  }
                },
                "examples": {
                  "200 OK": {
                    "value": {
                      "id": "jBakRtwbXA15ABQjVnBxo"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404 Not Found",
            "headers": {
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "example": "101"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "example": "not-found"
                        },
                        "message": {
                          "type": "string",
                          "example": "Group 'something-family-does-not-own' not found for family"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "404 Not Found": {
                    "value": {
                      "error": {
                        "code": "not-found",
                        "message": "Group 'something-family-does-not-own' not found for family"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "groupId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "servers": [
        {
          "url": "https://api.yotoplay.com",
          "description": "API server"
        }
      ]
