      "put": {
        "tags": [
          "Family Library Groups"
        ],
        "summary": "update a group",
        "description": "Update a group for a family.\n\n- The contextual family is the authorised user's family\n    \n- Groups can only be updated if a family owns them\n    \n    - If it does not exist a 404 is returned\n        \n    - If it exists but is owned by another family, a 404 is returned\n        \n- All of the critiera for [creating a group](https://yoto.dev/api/createAGroup) applies\n\n#### Required Scope\n\n`family:library:manage`",
        "operationId": "updateAGroup",
