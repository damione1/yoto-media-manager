                        },
                        "userId": {
                          "type": "string",
                          "example": "auth0|65afcb79a4f5ae5550e6e63a"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "200 OK": {
                    "value": {
                      "card": {
                        "cardId": "iMG7o",
                        "content": {
                          "activity": "yoto_Player",
                          "chapters": [],
                          "config": {},
                          "editSettings": {
                            "autoOverlayLabels": "disabled",
