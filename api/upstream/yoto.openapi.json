                  "type": "string",
                  "example": "Thu, 24 Jul 2025 13:39:35 GMT"
                }
              },
              "Via": {
                "schema": {
                  "type": "string",
                  "example": "1.1 427271f19372c1be0d143a1d4c76a128.cloudfront.net (CloudFront)"
                }
              },
              "X-Amz-Cf-Id": {
                "schema": {
                  "type": "string",
                  "example": "-QIC6S3EU5kb8VyRWquLGoO3wnW3iun8YYJ8-A1BkMJl3R6crpxKeQ=="
