    "/device-v2/{deviceId}/shortcuts": {
      "put": {
        "tags": [
          "Devices"
        ],
        "summary": "update shortcuts (beta)",
        "description": "This endpoint is used to update the shortcuts configuration for a specific device identified by `deviceId`.\n\n#### Request Body\n\nThe request body must be a JSON object structured as follows:\n\n- **shortcuts**: An object containing the modes for the shortcuts.\n    \n    - **modes**: An object that defines different modes.\n        \n        - **day**: An object representing the day mode.\n            \n            - **content**: An array of commands to be executed during the day. Each command is an object with:\n                \n                - **cmd**: A string representing the command type (e.g., \"track-play\").\n                    \n                - **params**: An object containing parameters for the command:\n                    \n                    - **card**: A string representing the card identifier.\n                        \n                    - **chapter**: A string representing the chapter name.\n                        \n                    - **track**: A string representing the track key. For Yoto Daily, this can also equal , which will dynamically play the track for the current day.\n                        \n        - **night**: An object representing the night mode.\n            \n            - **content**: An array of commands to be executed during the night (can be empty).\n\n#### Required Scope\n\n`family:devices:manage`",
        "operationId": "updateShortcutsBeta",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shortcuts": {
                    "type": "object",
                    "properties": {
                      "modes": {
                        "type": "object",
                        "properties": {
                          "day": {
                            "type": "object",
                            "properties": {
                              "content": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "cmd": {
                                      "type": "string",
                                      "example": "track-play"
                                    },
                                    "params": {
                                      "type": "object",
                                      "properties": {
                                        "card": {
                                          "type": "string",
                                          "example": "3nC80"
                                        },
                                        "chapter": {
                                          "type": "string",
                                          "example": "daily"
                                        },
                                        "track": {
                                          "type": "string",
                                          "example": "<yyyymmdd>"
                                        }
                                      }
                                    }
                                  }
                                },
                                "example": [
                                  {
                                    "cmd": "track-play",
                                    "params": {
                                      "card": "3nC80",
                                      "chapter": "daily",
                                      "track": "<yyyymmdd>"
                                    }
                                  },
                                  {
                                    "cmd": "track-play",
                                    "params": {
                                      "card": "3nC80",
                                      "chapter": "radio-day",
                                      "track": "01"
                                    }
                                  }
                                ]
                              }
                            }
                          },
                          "night": {
                            "type": "object",
                            "properties": {
                              "content": {
                                "type": "array",
                                "items": {},
                                "example": []
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "update shortcuts (beta)": {
                  "value": {
                    "shortcuts": {
                      "modes": {
                        "day": {
                          "content": [
                            {
                              "cmd": "track-play",
                              "params": {
                                "card": "3nC80",
                                "chapter": "daily",
                                "track": "<yyyymmdd>"
                              }
                            },
                            {
                              "cmd": "track-play",
                              "params": {
                                "card": "3nC80",
                                "chapter": "radio-day",
                                "track": "01"
                              }
                            }
                          ]
                        },
                        "night": {
                          "content": []
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
