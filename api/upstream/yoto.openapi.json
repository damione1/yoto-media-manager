    "/media/transcode/audio/uploadUrl": {
      "get": {
        "tags": [
          "Media"
        ],
        "summary": "get an upload url",
        "description": "Get a signed url that an audio file can be uploaded to. The sha256 hash sent in the request querystring is used to check if a file matching that checksum already exists in our store.\n\n### Response\n\n- Two fields are returned in the body: `uploadUrl` and `uploadId`.\n    \n- If the file already exists in our file store then `\"uploadUrl\": null` is returned\n    \n- If the file does not exists, then a signed `uploadUrl` is generated.\n\n#### Required Scope\n\n`user:content:manage`",
        "operationId": "getAnUploadUrl",
        "parameters": [
          {
            "name": "sha256",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "{{sha256}}"
            },
            "description": "The SHA256 hash of the source file to be uploaded. It is used to determine a successful upload (we SHA256 hash the file once it is uploaded to our file store and compare the hashes for a match)"
          },
          {
            "name": "filename",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "This Is The Name I Want For The File"
