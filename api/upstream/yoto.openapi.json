                  "type": "string",
                  "example": "b0bfe7f3-f415-4275-a699-173541de276a"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "card": {
                      "type": "object",
                      "properties": {
                        "cardId": {
                          "type": "string",
                          "example": "iMG7o"
                        },
                        "content": {
                          "type": "object",
                          "properties": {
                            "activity": {
                              "type": "string",
                              "example": "yoto_Player"
                            },
                            "chapters": {
                              "type": "array",
                              "items": {},
                              "example": []
                            },
                            "config": {
                              "type": "object",
                              "properties": {}
                            },
                            "editSettings": {
                              "type": "object",
                              "properties": {
                                "autoOverlayLabels": {
                                  "type": "string",
                                  "example": "disabled"
                                },
                                "editKeys": {
                                  "type": "boolean",
                                  "example": false
                                },
                                "transcodeAudioUploads": {
                                  "type": "boolean",
                                  "example": true
                                }
                              }
                            },
                            "version": {
                              "type": "string",
                              "example": "1"
                            }
                          }
                        },
                        "createdAt": {
                          "type": "string",
                          "example": "2021-05-07T14:08:26.435Z"
                        },
