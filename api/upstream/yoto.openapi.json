{
  "openapi": "3.0.3",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0",
    "contact": {}
  },
  "paths": {
    "/authorize": {
      "servers": [
        {
          "url": "https://login.yotoplay.com",
          "description": "Authentication server"
        }
      ],
      "get": {
        "operationId": "get-authorize",
        "summary": "Authorize a browser client",
        "description": "Redirects the user to Yoto's login page to begin the OAuth2 Authorization Code flow",
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "audience",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://api.yotoplay.com"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "offline_access profile"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code",
                "token",
                "id_token",
                "code token",
                "code id_token",
                "token id_token",
                "code token id_token"
              ]
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "description": "Opaque value for preventing CSRF attacks",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonce",
            "in": "query",
            "description": "String value to prevent replay attacks",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prompt",
            "in": "query",
            "description": "Specifies the authorization server prompt behavior",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "login",
                "consent",
                "select_account"
              ]
            }
          },
          {
            "name": "max_age",
            "in": "query",
            "description": "Maximum authentication age in seconds",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "description": "PKCE code challenge",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "description": "PKCE code challenge method",
            "schema": {
              "type": "string",
              "enum": [
                "S256",
                "plain"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to login page or callback URL",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri",
                  "description": "For code response_type: redirect_uri?code=CODE&state=STATE\nFor token response_type: redirect_uri#access_token=TOKEN&token_type=Bearer&expires_in=3600&state=STATE\nFor id_token response_type: redirect_uri#id_token=ID_TOKEN&state=STATE"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "unauthorized_client",
                        "access_denied",
                        "unsupported_response_type",
                        "invalid_scope",
                        "server_error",
                        "temporarily_unavailable"
                      ]
                    },
                    "error_description": {
                      "type": "string"
                    },
                    "error_uri": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "servers": [
        {
          "url": "https://login.yotoplay.com",
          "description": "Authentication server"
        }
      ],
      "post": {
        "operationId": "post-oauth-token",
        "summary": "Exchange tokens",
        "description": "Exchange authorization code or refresh token for access tokens",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "oneOf": [
                  {
                    "properties": {
                      "grant_type": {
                        "type": "string",
                        "enum": [
                          "authorization_code"
                        ]
                      },
                      "client_id": {
                        "type": "string"
                      },
                      "client_secret": {
                        "type": "string",
                        "description": "Optional for public clients (browser-based apps)"
                      },
                      "code": {
                        "type": "string"
                      },
                      "redirect_uri": {
                        "type": "string",
                        "format": "uri"
                      },
                      "code_verifier": {
                        "type": "string",
                        "description": "PKCE code verifier"
                      }
                    },
                    "required": [
                      "grant_type",
                      "client_id",
                      "code",
                      "redirect_uri"
                    ]
                  },
                  {
                    "properties": {
                      "grant_type": {
                        "type": "string",
                        "enum": [
                          "refresh_token"
                        ]
                      },
                      "client_id": {
                        "type": "string"
                      },
                      "client_secret": {
                        "type": "string",
                        "description": "Optional for public clients (browser-based apps)"
                      },
                      "refresh_token": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "string",
                        "description": "Optional scope to request with refresh"
                      }
                    },
                    "required": [
                      "grant_type",
                      "client_id",
                      "refresh_token"
                    ]
                  },
                  {
                    "properties": {
                      "grant_type": {
                        "type": "string",
                        "enum": [
                          "urn:ietf:params:oauth:grant-type:device_code"
                        ]
                      },
                      "device_code": {
                        "type": "string"
                      },
                      "client_id": {
                        "type": "string"
                      },
                      "audience": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "grant_type",
                      "device_code",
                      "client_id",
                      "audience"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful token response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Expiration time in seconds"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "description": "Space-separated list of granted scopes"
                    },
                    "id_token": {
                      "type": "string",
                      "description": "JWT containing user claims"
                    },
                    "expires_at": {
                      "type": "integer",
                      "description": "Timestamp when the token expires"
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "invalid_client",
                        "invalid_grant",
                        "unauthorized_client",
                        "unsupported_grant_type",
                        "invalid_scope",
                        "authorization_pending",
                        "slow_down",
                        "expired_token"
                      ]
                    },
                    "error_description": {
                      "type": "string"
                    },
                    "error_uri": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_client"
                      ]
                    },
                    "error_description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/oauth/device/code": {
      "servers": [
        {
          "url": "https://login.yotoplay.com",
          "description": "Authentication server"
        }
      ],
      "post": {
        "operationId": "post-oauth-device-code",
        "summary": "Initialize device authorization flow",
        "description": "Start the OAuth2 Device Authorization flow for CLI/server-side applications.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string",
                    "example": "profile offline_access"
                  },
                  "audience": {
                    "type": "string",
                    "example": "https://api.yotoplay.com"
                  }
                },
                "required": [
                  "client_id",
                  "scope",
                  "audience"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device code response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_code": {
                      "type": "string",
                      "description": "The device verification code"
                    },
                    "user_code": {
                      "type": "string",
                      "description": "The code displayed to the user"
                    },
                    "verification_uri": {
                      "type": "string",
                      "format": "uri",
                      "description": "The URL where the user should enter the user_code"
                    },
                    "verification_uri_complete": {
                      "type": "string",
                      "format": "uri",
                      "description": "The verification URL with the code included"
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "The lifetime of the device code in seconds"
                    },
                    "interval": {
                      "type": "integer",
                      "description": "Minimum polling interval in seconds"
                    }
                  },
                  "required": [
                    "device_code",
                    "user_code",
                    "verification_uri",
                    "expires_in",
                    "interval"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "unauthorized_client",
                        "access_denied",
                        "invalid_scope"
                      ]
                    },
                    "error_description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/content/{cardId}": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "get content",
        "description": "Returns a piece of content. A user can view a piece of content if:\n\n- They own the content\n    \n- If they have an appropriate content viewer/editor role\n    \n\nIf a user is not allowed to view the content, a 404 is returned.\n\n#### Time zones\n\nProviding a `timezone` param will result in returning a piece of content with chapters where:\n\n- `availableFrom` is set to a date up to and including today in the provided time zone\n    \n- `availableFrom` is null or absent\n    \n\nCurrently this only applies to podcast content; providing the `timezone` param for non-podcast content will not affect the chapters returned.\n\nValid timezone identifiers can be found [here](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones). A 400 response will be returned if an invalid time zone is provided. If no `timezone` param is provided, then chapters are returned based on the UTC timezone.\n\n#### Required Scope\n\n`user:content:view`",
        "operationId": "getContent",
        "parameters": [
          {
            "name": "timezone",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "Pacific/Auckland"
            },
            "description": "Timezone identifier"
          },
          {
            "name": "signingType",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "s3"
            },
            "description": "The type of playable signed URLs returned. Use with `playable`."
          },
          {
            "name": "playable",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "true"
            },
            "description": "Return playable signed URLs"
          }
        ],
        "responses": {
          "200": {
            "description": "200 OK",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "example": "598"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Thu, 23 Jan 2025 13:37:59 GMT"
                }
              },
              "Via": {
                "schema": {
                  "type": "string",
                  "example": "1.1 e1ae90c8976c495754c02b2e4bee42cc.cloudfront.net (CloudFront)"
                }
              },
              "X-Amz-Cf-Id": {
                "schema": {
                  "type": "string",
                  "example": "2ls97bN8l7-XZkEnQ1fxUzIqmecCBiAY3eTrvX_3A0ZoQw42r_fBwg=="
                }
              },
              "X-Amz-Cf-Pop": {
                "schema": {
                  "type": "string",
                  "example": "LHR61-P6"
                }
              },
              "X-Amzn-Trace-Id": {
                "schema": {
                  "type": "string",
                  "example": "Root=1-67924637-2fb5252a39135b926df3791f"
                }
              },
              "X-Cache": {
                "schema": {
                  "type": "string",
