                        "updatedAt": "2023-06-22T10:16:53.717Z",
                        "userId": "auth0|65afcb79a4f5ae5550e6e63a"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400 Bad Request (Invalid timezone)",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              },
              "Connection": {
                "schema": {
