    "/media/coverImage/user/me/upload": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "upload cover image",
        "description": "This endpoint enables uploading a cover image to a user's media account.\n\nIt supports both direct file uploads and URL-based image fetching, with automatic image conversion.\n\nUploaded images are resized according to the `coverType` provided, else default dimensions are used. Aspect ratio is preserved and the image is cropped to fit these dimensions, positioned to the centre.\n\n| **coverType** | **height (px)** | **width (px)** |\n| --- | --- | --- |\n| default | 1011 | 638 |\n| activities | 1011 | 638 |\n| music | 1011 | 638 |\n| myo | 400 | 520 |\n| podcast | 600 | 600 |\n| radio | 600 | 600 |\n| sfx | 1011 | 638 |\n| stories | 1011 | 638 |\n\n#### Required Scope\n\n`user:content:manage`",
        "operationId": "uploadCoverImage",
        "parameters": [
          {
            "name": "imageUrl",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "https://picsum.photos/id/237/200/300.jpg"
            },
            "description": "URL of an image to fetch and upload. Required if no file body is provided."
          },
          {
            "name": "autoconvert",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "true"
            },
            "description": "Whether to automatically convert the image to the specified cover type. Boolean,"
          },
          {
            "name": "coverType",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "default"
            },
            "description": "The type of cover image to create. This determines the image dimensions."
          },
          {
            "name": "filename",
            "in": "query",
            "schema": {
              "type": "string",
              "example": ""
            },
            "description": "Custom filename for the uploaded image."
          }
        ],
