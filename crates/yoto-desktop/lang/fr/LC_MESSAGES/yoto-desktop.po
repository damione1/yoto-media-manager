msgid "Une clé de chapitre ou de piste est trop longue pour Yoto."
msgstr "Une clé de chapitre ou de piste est trop longue pour Yoto."

#: src/ui/wording.rs
msgid ""
"Ces deux pistes portent la même clé Yoto. Déplacez-les dans des chapitres "
"distincts pour conserver leurs références."
msgstr ""
"Ces deux pistes portent la même clé Yoto. Déplacez-les dans des chapitres "
"distincts pour conserver leurs références."

