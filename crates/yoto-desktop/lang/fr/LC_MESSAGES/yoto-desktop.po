msgid "Indiquez une heure au format HH:MM, par exemple 07:30."
msgstr "Indiquez une heure au format HH:MM, par exemple 07:30."

#: src/ui/wording.rs
msgid "Indiquez une couleur au format #RRGGBB, par exemple #FF8800."
msgstr "Indiquez une couleur au format #RRGGBB, par exemple #FF8800."

#: src/ui/wording.rs
msgid "Les limites et les durées doivent être des nombres entiers positifs."
msgstr "Les limites et les durées doivent être des nombres entiers positifs."

#: src/ui/wording.rs
msgid "Le volume doit être compris entre 0 et 100."
msgstr "Le volume doit être compris entre 0 et 100."

#: src/ui/wording.rs
msgid ""
"Le serveur des mises à jour ne répond pas. Vérifiez votre connexion Internet "
"puis réessayez."
msgstr ""
"Le serveur des mises à jour ne répond pas. Vérifiez votre connexion Internet "
"puis réessayez."

