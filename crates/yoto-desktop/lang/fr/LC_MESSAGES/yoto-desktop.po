msgstr "Autre médiathèque"

#: src/ui/wording.rs
msgid ""
"Ouvrez une autre médiathèque de cet ordinateur, par exemple une médiathèque "
"importée. Elle s’ouvre dans une nouvelle fenêtre."
msgstr ""
"Ouvrez une autre médiathèque de cet ordinateur, par exemple une médiathèque "
"importée. Elle s’ouvre dans une nouvelle fenêtre."

#: src/ui/wording.rs
msgid "Ouvrir une autre médiathèque"
msgstr "Ouvrir une autre médiathèque"

#: src/ui/wording.rs
msgid "Ouvrir une autre médiathèque Yoto"
msgstr "Ouvrir une autre médiathèque Yoto"

#: src/ui/wording.rs
msgid "Exporter la médiathèque…"
msgstr "Exporter la médiathèque…"

#: src/ui/wording.rs
msgid "Importer une médiathèque…"
msgstr "Importer une médiathèque…"

#: src/ui/wording.rs
msgid "Exporter la médiathèque"
msgstr "Exporter la médiathèque"

#: src/ui/wording.rs
msgid "Importer une médiathèque"
msgstr "Importer une médiathèque"

#: src/ui/wording.rs
msgid ""
"Enregistrez une copie protégée de toute votre médiathèque (audios, versions "
"préparées et playlists), par exemple sur une clé USB, pour changer "
"d’ordinateur ou en cas de pépin."
msgstr ""
"Enregistrez une copie protégée de toute votre médiathèque (audios, versions "
"préparées et playlists), par exemple sur une clé USB, pour changer "
"d’ordinateur ou en cas de pépin."

#: src/ui/wording.rs
msgid ""
"Retrouvez une médiathèque exportée depuis cette application. Elle s’ouvre à "
"côté de celle-ci, dans une nouvelle fenêtre : rien n’est remplacé."
msgstr ""
"Retrouvez une médiathèque exportée depuis cette application. Elle s’ouvre à "
"côté de celle-ci, dans une nouvelle fenêtre : rien n’est remplacé."

#: src/ui/wording.rs
msgid "1. Choisissez où enregistrer l’export"
msgstr "1. Choisissez où enregistrer l’export"

#: src/ui/wording.rs
msgid "2. Notez la clé de récupération"
msgstr "2. Notez la clé de récupération"

#: src/ui/wording.rs
msgid "1. Collez la clé de récupération"
msgstr "1. Collez la clé de récupération"

#: src/ui/wording.rs
msgid "2. Choisissez l’export"
msgstr "2. Choisissez l’export"

#: src/ui/wording.rs
msgid "Choisir un dossier…"
msgstr "Choisir un dossier…"

#: src/ui/wording.rs
msgid "Choisir un autre dossier…"
msgstr "Choisir un autre dossier…"

#: src/ui/wording.rs
msgid "Choisir l’export…"
msgstr "Choisir l’export…"

#: src/ui/wording.rs
msgid "Choisir un autre export…"
msgstr "Choisir un autre export…"

#: src/ui/wording.rs
msgid "Aucun dossier choisi."
msgstr "Aucun dossier choisi."

#: src/ui/wording.rs
msgid "Où enregistrer l’export de la médiathèque ?"
msgstr "Où enregistrer l’export de la médiathèque ?"

#: src/ui/wording.rs
msgid "Choisissez le dossier de l’export à importer"
msgstr "Choisissez le dossier de l’export à importer"

#: src/ui/wording.rs
msgid ""
"Cette clé protège l’export : sans elle, personne ne pourra l’ouvrir, pas "
"même vous. Notez-la sur papier ou dans votre gestionnaire de mots de passe, "
"et gardez-la à part de l’export."
msgstr ""
"Cette clé protège l’export : sans elle, personne ne pourra l’ouvrir, pas "
"même vous. Notez-la sur papier ou dans votre gestionnaire de mots de passe, "
"et gardez-la à part de l’export."

#: src/ui/wording.rs
msgid "Clé notée lors de l’export"
msgstr "Clé notée lors de l’export"

#: src/ui/wording.rs
msgid "Copier"
msgstr "Copier"

#: src/ui/wording.rs
msgid "Copiée"
msgstr "Copiée"

#: src/ui/wording.rs
msgid "Exporter"
msgstr "Exporter"

#: src/ui/wording.rs
msgid "Importer"
msgstr "Importer"

#: src/ui/wording.rs
msgid ""
"Export en cours… Cela peut prendre quelques minutes pour une grande "
"médiathèque."
msgstr ""
"Export en cours… Cela peut prendre quelques minutes pour une grande "
"médiathèque."

#: src/ui/wording.rs
msgid "Import en cours : chaque fichier est vérifié…"
msgstr "Import en cours : chaque fichier est vérifié…"

#: src/ui/wording.rs
msgid "Ouvrir la médiathèque importée"
msgstr "Ouvrir la médiathèque importée"

#: src/ui/wording.rs
msgid "Collez d’abord la clé de récupération notée lors de l’export."
msgstr "Collez d’abord la clé de récupération notée lors de l’export."

#: src/ui/wording.rs
msgid ""
"Cette clé de récupération est incomplète ou contient une faute de frappe. "
"Recopiez-la exactement comme elle a été notée lors de l’export (8 groupes de "
"8 lettres et chiffres)."
msgstr ""
"Cette clé de récupération est incomplète ou contient une faute de frappe. "
"Recopiez-la exactement comme elle a été notée lors de l’export (8 groupes de "
"8 lettres et chiffres)."

#: src/ui/wording.rs
msgid "Choisissez d’abord un dossier."
msgstr "Choisissez d’abord un dossier."

#: src/ui/wording.rs
msgid "Choisissez d’abord le dossier de l’export."
msgstr "Choisissez d’abord le dossier de l’export."

#: src/ui/wording.rs
msgid ""
"Ce dossier ne contient pas d’export de médiathèque. Choisissez le dossier "
"créé par « Exporter la médiathèque… »."
msgstr ""
"Ce dossier ne contient pas d’export de médiathèque. Choisissez le dossier "
"créé par « Exporter la médiathèque… »."

#: src/ui/wording.rs
msgid ""
"L’application ne trouve pas le dossier de ses médiathèques sur cet "
"ordinateur."
msgstr ""
"L’application ne trouve pas le dossier de ses médiathèques sur cet "
"ordinateur."

#: src/ui/wording.rs
#, rust-format
msgid "Médiathèque Yoto {date}"
msgstr "Médiathèque Yoto {date}"

#: src/ui/wording.rs
#, rust-format
msgid "{library} importée {date}"
msgstr "{library} importée {date}"

#: src/ui/wording.rs
#, rust-format
msgid ""
"Médiathèque exportée dans « {path} ». Gardez bien la clé de récupération."
msgstr ""
"Médiathèque exportée dans « {path} ». Gardez bien la clé de récupération."

#: src/ui/wording.rs
#, rust-format
msgid ""
"Médiathèque importée dans « {path} ». Ouvrez-la pour la retrouver ; "
"reconnectez ensuite votre compte Yoto dans « Compte »."
msgstr ""
"Médiathèque importée dans « {path} ». Ouvrez-la pour la retrouver ; "
"reconnectez ensuite votre compte Yoto dans « Compte »."

#: src/ui/wording.rs
#, rust-format
msgid "L’export n’a pas abouti. {reason}"
msgstr "L’export n’a pas abouti. {reason}"

#: src/ui/wording.rs
#, rust-format
msgid "L’import n’a pas abouti. {reason}"
msgstr "L’import n’a pas abouti. {reason}"

#: src/ui/wording.rs
msgid ""
"Yoto n’autorise pas cette action pour ce compte. Reconnectez votre compte "
"pour accorder l’accès."
msgstr ""
"Yoto n’autorise pas cette action pour ce compte. Reconnectez votre compte "
"pour accorder l’accès."

#: src/ui/wording.rs
msgid ""
"Yoto a peut-être reçu la modification. Vérifiez le résultat dans « Imports » "
"avant de réessayer."
msgstr ""
"Yoto a peut-être reçu la modification. Vérifiez le résultat dans « Imports » "
"avant de réessayer."

#: src/ui/wording.rs
msgid ""
"Ce lien n’est pas une adresse valide. Collez un lien YouTube complet "
"(https://…)."
msgstr ""
"Ce lien n’est pas une adresse valide. Collez un lien YouTube complet "
"(https://…)."

#: src/ui/wording.rs
msgid "Seuls les liens YouTube (youtube.com ou youtu.be) sont acceptés."
msgstr "Seuls les liens YouTube (youtube.com ou youtu.be) sont acceptés."

#: src/ui/wording.rs
msgid "Cette vidéo dure plus de 2 heures ; l’import est limité à 2 heures."
msgstr "Cette vidéo dure plus de 2 heures ; l’import est limité à 2 heures."

#: src/ui/wording.rs
msgid ""
"Le téléchargement YouTube a échoué. La vidéo est peut-être privée, supprimée "
"ou indisponible dans votre pays."
msgstr ""
"Le téléchargement YouTube a échoué. La vidéo est peut-être privée, supprimée "
"ou indisponible dans votre pays."

#: src/ui/wording.rs
msgid ""
"Cette vidéo YouTube est privée ou réservée aux membres d’une chaîne : elle "
"ne peut pas être importée."
msgstr ""
"Cette vidéo YouTube est privée ou réservée aux membres d’une chaîne : elle "
"ne peut pas être importée."

#: src/ui/wording.rs
msgid ""
"Cette vidéo YouTube est réservée aux adultes : YouTube demande une connexion "
"pour la lire, elle ne peut donc pas être importée."
msgstr ""
"Cette vidéo YouTube est réservée aux adultes : YouTube demande une connexion "
"pour la lire, elle ne peut donc pas être importée."

#: src/ui/wording.rs
msgid "Cette vidéo YouTube n’est pas disponible dans votre pays."
msgstr "Cette vidéo YouTube n’est pas disponible dans votre pays."

#: src/ui/wording.rs
msgid "Cette vidéo YouTube n’existe plus ou a été retirée. Vérifiez le lien."
msgstr "Cette vidéo YouTube n’existe plus ou a été retirée. Vérifiez le lien."

#: src/ui/wording.rs
msgid ""
"YouTube a changé et l’application ne sait plus lire cette vidéo, même après "
"avoir cherché une version plus récente de son outil YouTube. Réessayez plus "
"tard."
msgstr ""
"YouTube a changé et l’application ne sait plus lire cette vidéo, même après "
"avoir cherché une version plus récente de son outil YouTube. Réessayez plus "
"tard."

#: src/ui/wording.rs
msgid ""
"YouTube bloque pour un moment les téléchargements depuis votre connexion. "
"Réessayez dans quelques minutes."
msgstr ""
"YouTube bloque pour un moment les téléchargements depuis votre connexion. "
"Réessayez dans quelques minutes."

#: src/ui/wording.rs
msgid ""
"YouTube ne répond pas. Vérifiez votre connexion Internet puis réessayez."
msgstr ""
"YouTube ne répond pas. Vérifiez votre connexion Internet puis réessayez."

#: src/ui/wording.rs
msgid "Ce lien est une playlist YouTube : choisissez les vidéos à importer."
msgstr "Ce lien est une playlist YouTube : choisissez les vidéos à importer."

#: src/ui/wording.rs
msgid "Cette vidéo n’est pas reconnue. Vérifiez le lien."
msgstr "Cette vidéo n’est pas reconnue. Vérifiez le lien."

#: src/ui/wording.rs
msgid "Ce fichier est introuvable. Il a peut-être été déplacé ou supprimé."
msgstr "Ce fichier est introuvable. Il a peut-être été déplacé ou supprimé."

#: src/ui/wording.rs
msgid "Ce fichier n’est pas un fichier audio lisible."
msgstr "Ce fichier n’est pas un fichier audio lisible."

#: src/ui/wording.rs
msgid "Ce fichier audio est vide."
msgstr "Ce fichier audio est vide."

#: src/ui/wording.rs
msgid ""
"La préparation de l’audio a échoué. Réessayez ; si le problème persiste, "
"réimportez le fichier."
msgstr ""
"La préparation de l’audio a échoué. Réessayez ; si le problème persiste, "
"réimportez le fichier."

#: src/ui/wording.rs
msgid ""
"Cet extrait dépasse ce que Yoto accepte (1 h ou 100 Mo par piste). "
"Raccourcissez-le."
msgstr ""
"Cet extrait dépasse ce que Yoto accepte (1 h ou 100 Mo par piste). "
"Raccourcissez-le."

#: src/ui/wording.rs
msgid ""
"Une piste de cette playlist dure plus d’une heure, la limite de Yoto. "
"Retirez-la puis ajoutez de nouveau ce média : il sera découpé en plusieurs "
"parties."
msgstr ""
"Une piste de cette playlist dure plus d’une heure, la limite de Yoto. "
"Retirez-la puis ajoutez de nouveau ce média : il sera découpé en plusieurs "
"parties."

#: src/ui/wording.rs
msgid ""
"Cet audio est trop long pour être écouté ici. Découpez-le en parties plus "
"courtes."
msgstr ""
"Cet audio est trop long pour être écouté ici. Découpez-le en parties plus "
"courtes."

#: src/ui/wording.rs
msgid "Cette playlist dépasse ce que Yoto accepte (100 pistes, 5 h ou 500 Mo)."
msgstr ""
"Cette playlist dépasse ce que Yoto accepte (100 pistes, 5 h ou 500 Mo)."

#: src/ui/wording.rs
msgid ""
"Yoto refuse les pistes de plus de 60 minutes. Raccourcissez cette piste ou "
"découpez-la en plusieurs pistes."
msgstr ""
"Yoto refuse les pistes de plus de 60 minutes. Raccourcissez cette piste ou "
"découpez-la en plusieurs pistes."

#: src/ui/wording.rs
msgid ""
"Yoto refuse les pistes de plus de 100 Mo. Raccourcissez cette piste ou "
"découpez-la en plusieurs pistes."
msgstr ""
"Yoto refuse les pistes de plus de 100 Mo. Raccourcissez cette piste ou "
"découpez-la en plusieurs pistes."

#: src/ui/wording.rs
msgid ""
"Yoto refuse les playlists de plus de 5 heures au total. Retirez des pistes "
"ou répartissez-les sur deux playlists."
msgstr ""
"Yoto refuse les playlists de plus de 5 heures au total. Retirez des pistes "
"ou répartissez-les sur deux playlists."

#: src/ui/wording.rs
msgid ""
"Yoto refuse les playlists de plus de 500 Mo au total. Retirez des pistes ou "
"répartissez-les sur deux playlists."
msgstr ""
"Yoto refuse les playlists de plus de 500 Mo au total. Retirez des pistes ou "
"répartissez-les sur deux playlists."

#: src/ui/wording.rs
msgid ""
"Ce lien de flux n’est pas une adresse valide. Collez une adresse complète "
"qui commence par https://."
msgstr ""
"Ce lien de flux n’est pas une adresse valide. Collez une adresse complète "
"qui commence par https://."

#: src/ui/wording.rs
msgid "Seuls les liens de flux qui commencent par https:// sont acceptés."
msgstr "Seuls les liens de flux qui commencent par https:// sont acceptés."

#: src/ui/wording.rs
msgid ""
"Ce média est utilisé dans une playlist. Retirez-le de la playlist avant de "
"le supprimer."
msgstr ""
"Ce média est utilisé dans une playlist. Retirez-le de la playlist avant de "
"le supprimer."

#: src/ui/wording.rs
msgid ""
"Une tâche utilise encore ce média. Attendez qu’elle se termine ou annulez-la "
"dans « Imports »."
msgstr ""
"Une tâche utilise encore ce média. Attendez qu’elle se termine ou annulez-la "
"dans « Imports »."

#: src/ui/wording.rs
msgid ""
"Un envoi vers Yoto doit d’abord être vérifié dans « Imports » avant de "
"supprimer ce média."
msgstr ""
"Un envoi vers Yoto doit d’abord être vérifié dans « Imports » avant de "
"supprimer ce média."

#: src/ui/wording.rs
msgid "Ce média n’existe plus dans votre médiathèque."
msgstr "Ce média n’existe plus dans votre médiathèque."

#: src/ui/wording.rs
msgid "Choisissez au moins un média."
msgstr "Choisissez au moins un média."

#: src/ui/wording.rs
msgid "Cette version n’appartient pas au média choisi."
msgstr "Cette version n’appartient pas au média choisi."

#: src/ui/wording.rs
msgid "Cette playlist n’existe plus."
msgstr "Cette playlist n’existe plus."

#: src/ui/wording.rs
msgid "Cette tâche n’existe plus."
msgstr "Cette tâche n’existe plus."

#: src/ui/wording.rs
msgid ""
"Un envoi précédent de cette playlist vers Yoto attend encore une "
"vérification. Ouvrez « Imports » pour le vérifier, puis enregistrez de "
"nouveau."
msgstr ""
"Un envoi précédent de cette playlist vers Yoto attend encore une "
"vérification. Ouvrez « Imports » pour le vérifier, puis enregistrez de "
"nouveau."

#: src/ui/wording.rs
msgid ""
"Cet envoi a peut-être déjà abouti sur Yoto. Choisissez « Vérifier la "
"publication » plutôt que « Réessayer »."
msgstr ""
"Cet envoi a peut-être déjà abouti sur Yoto. Choisissez « Vérifier la "
"publication » plutôt que « Réessayer »."

#: src/ui/wording.rs
msgid "Cette tâche ne peut pas être relancée telle quelle. Ouvrez ses détails."
msgstr ""
"Cette tâche ne peut pas être relancée telle quelle. Ouvrez ses détails."

#: src/ui/wording.rs
msgid "Cette tâche est déjà terminée."
msgstr "Cette tâche est déjà terminée."

#: src/ui/wording.rs
msgid ""
"Terminez les imports, préparations et envois en cours avant d’installer la "
"mise à jour."
msgstr ""
"Terminez les imports, préparations et envois en cours avant d’installer la "
"mise à jour."

#: src/ui/wording.rs
msgid "L’application redémarre pour installer une mise à jour."
msgstr "L’application redémarre pour installer une mise à jour."

#: src/ui/wording.rs
msgid ""
"Fermez l’autre fenêtre de l’application avant d’installer la mise à jour."
msgstr ""
"Fermez l’autre fenêtre de l’application avant d’installer la mise à jour."

#: src/ui/wording.rs
msgid ""
"La mise à jour n’a pas pu démarrer. Téléchargez la nouvelle version depuis "
"GitHub Releases."
msgstr ""
"La mise à jour n’a pas pu démarrer. Téléchargez la nouvelle version depuis "
"GitHub Releases."

#: src/ui/wording.rs
msgid ""
"Une autre tentative de connexion est encore ouverte. Fermez-la puis "
"réessayez."
msgstr ""
"Une autre tentative de connexion est encore ouverte. Fermez-la puis "
"réessayez."

#: src/ui/wording.rs
msgid "Le navigateur n’a pas pu s’ouvrir. Ouvrez-le vous-même puis réessayez."
msgstr "Le navigateur n’a pas pu s’ouvrir. Ouvrez-le vous-même puis réessayez."

#: src/ui/wording.rs
msgid ""
"Vous avez refusé l’accès dans le navigateur. Réessayez et acceptez les "
"autorisations demandées."
msgstr ""
"Vous avez refusé l’accès dans le navigateur. Réessayez et acceptez les "
"autorisations demandées."

#: src/ui/wording.rs
msgid "Yoto refuse cette action pour ce compte."
msgstr "Yoto refuse cette action pour ce compte."

#: src/ui/wording.rs
msgid "Yoto ne trouve plus cet élément. Actualisez depuis Yoto puis réessayez."
msgstr ""
"Yoto ne trouve plus cet élément. Actualisez depuis Yoto puis réessayez."

#: src/ui/wording.rs
msgid "Choisissez un lecteur."
msgstr "Choisissez un lecteur."

#: src/ui/wording.rs
msgid "Entrez un nom pour le lecteur."
msgstr "Entrez un nom pour le lecteur."

#: src/ui/wording.rs
msgid "Le nom du groupe doit contenir entre 1 et 100 caractères."
msgstr "Le nom du groupe doit contenir entre 1 et 100 caractères."

#: src/ui/wording.rs
msgid "L’image dépasse 8 Mo."
msgstr "L’image dépasse 8 Mo."

#: src/ui/wording.rs
msgid "L’image est trop grande (8192 pixels maximum)."
msgstr "L’image est trop grande (8192 pixels maximum)."

#: src/ui/wording.rs
msgid "Cette image ne peut pas servir d’icône."
msgstr "Cette image ne peut pas servir d’icône."

#: src/ui/wording.rs
msgid "Cette icône n’a pas encore été envoyée à Yoto."
msgstr "Cette icône n’a pas encore été envoyée à Yoto."

#: src/ui/wording.rs
msgid "La sortie audio ne répond pas. Vérifiez le son de votre ordinateur."
msgstr "La sortie audio ne répond pas. Vérifiez le son de votre ordinateur."

#: src/ui/wording.rs
msgid ""
"L’application a reçu une réponse inattendue. Réessayez ; si le problème "
"continue, redémarrez l’application."
msgstr ""
"L’application a reçu une réponse inattendue. Réessayez ; si le problème "
"continue, redémarrez l’application."

#: src/ui/wording.rs
msgid ""
"Un fichier de ce nom existe déjà à cet endroit. Choisissez un autre nom."
msgstr ""
"Un fichier de ce nom existe déjà à cet endroit. Choisissez un autre nom."

#: src/ui/wording.rs
msgid ""
"Cette clé de récupération ne correspond pas à cet export, ou l’export a été "
"modifié depuis. Vérifiez la clé notée lors de l’export."
msgstr ""
"Cette clé de récupération ne correspond pas à cet export, ou l’export a été "
"modifié depuis. Vérifiez la clé notée lors de l’export."

#: src/ui/wording.rs
msgid ""
"Ce dossier n’est pas un export de médiathèque. Choisissez le dossier créé "
"par « Exporter la médiathèque… »."
msgstr ""
"Ce dossier n’est pas un export de médiathèque. Choisissez le dossier créé "
"par « Exporter la médiathèque… »."

#: src/ui/wording.rs
msgid ""
"Cet export vient d’une version plus récente de l’application. Mettez "
"l’application à jour puis réessayez."
msgstr ""
"Cet export vient d’une version plus récente de l’application. Mettez "
"l’application à jour puis réessayez."

#: src/ui/wording.rs
msgid "Cet export est incomplet ou endommagé : il ne peut pas être importé."
msgstr "Cet export est incomplet ou endommagé : il ne peut pas être importé."

#: src/ui/wording.rs
msgid ""
"Un dossier du même nom existe déjà à cet endroit. Réessayez dans un instant "
"ou choisissez un autre dossier."
msgstr ""
"Un dossier du même nom existe déjà à cet endroit. Réessayez dans un instant "
"ou choisissez un autre dossier."

#: src/ui/wording.rs
msgid "Choisissez un dossier sur cet ordinateur, pas la racine d’un disque."
msgstr "Choisissez un dossier sur cet ordinateur, pas la racine d’un disque."

#: src/ui/wording.rs
msgid "Le titre doit contenir entre 1 et 140 caractères."
msgstr "Le titre doit contenir entre 1 et 140 caractères."

#: src/ui/wording.rs
msgid "Ajoutez au moins un média à la playlist."
msgstr "Ajoutez au moins un média à la playlist."

#: src/ui/wording.rs
msgid "Une playlist Yoto accepte au plus 100 pistes."
msgstr "Une playlist Yoto accepte au plus 100 pistes."

#: src/ui/wording.rs
msgid "Un chapitre doit contenir au moins une piste."
msgstr "Un chapitre doit contenir au moins une piste."

#: src/ui/wording.rs
msgid "La plage de lecture aléatoire est invalide."
msgstr "La plage de lecture aléatoire est invalide."

#: src/ui/wording.rs
msgid "Deux chapitres portent la même clé Yoto."
msgstr "Deux chapitres portent la même clé Yoto."

#: src/ui/wording.rs
msgid "Deux pistes portent la même clé Yoto."
msgstr "Deux pistes portent la même clé Yoto."

#: src/ui/wording.rs
msgid ""
"Ces deux pistes portent la même clé Yoto. Déplacez-les dans des chapitres "
"distincts pour conserver leurs références."
msgstr ""
"Ces deux pistes portent la même clé Yoto. Déplacez-les dans des chapitres "
"distincts pour conserver leurs références."

#: src/ui/wording.rs
msgid ""
"Cette playlist contient des événements interactifs non reconnus. Vérifiez-"
"les avant de réorganiser les pistes."
msgstr ""
"Cette playlist contient des événements interactifs non reconnus. Vérifiez-"
"les avant de réorganiser les pistes."

#: src/ui/wording.rs
msgid ""
"Retirez d’abord les événements interactifs qui renvoient à une piste (mode "
"avancé) avant de réorganiser la playlist."
msgstr ""
"Retirez d’abord les événements interactifs qui renvoient à une piste (mode "
"avancé) avant de réorganiser la playlist."

#: src/ui/wording.rs
msgid ""
"Ce changement touche une plage de lecture aléatoire. Retirez d’abord cette "
"plage dans les options de la playlist."
msgstr ""
