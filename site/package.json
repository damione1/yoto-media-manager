{
  "name": "yotomediamanager-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "images": "python3 scripts/optimize_images.py",
    "test": "npm run build && node --test",
    "preview": "npm run build && wrangler dev --local --port 8787 --infer-origin-from-routes=false",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "wrangler": "4.154.0"
  }
}
