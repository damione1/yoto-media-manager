<!doctype html>
<html lang="{{ loc.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or t.meta.description }}">
  <meta name="theme-color" content="#FFF8EF">
  <link rel="preload" href="/fonts/nunito-regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/fredoka-semibold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/css/site.css' | bust }}">
  {%- if not isDocs and not is404 %}
  <link rel="stylesheet" href="{{ '/css/mocks.css' | bust }}">
  {%- endif %}
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/img/app-icon.svg" type="image/svg+xml" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  {%- if not is404 %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- for alt in locales %}
  <link rel="alternate" hreflang="{{ alt.htmlLang }}" href="{{ site.url }}{{ page.url | localeUrl(alt.code) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url | localeUrl('en') }}">
  {%- else %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or t.meta.ogDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-{{ loc.code }}.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ t.meta.imageAlt }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ loc.ogLocale }}">
  {%- for alt in locales %}{% if alt.code != loc.code %}
  <meta property="og:locale:alternate" content="{{ alt.ogLocale }}">
  {%- endif %}{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description or t.meta.ogDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/og-{{ loc.code }}.png">
  <meta name="twitter:image:alt" content="{{ t.meta.imageAlt }}">
  {%- if not isDocs and not is404 %}
  {% set app = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": site.url + "/#software",
    "name": site.name,
    "description": t.meta.description,
    "url": site.url + page.url,
    "image": site.url + "/og-" + loc.code + ".png",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "macOS, Windows",
    "downloadUrl": [site.download.mac, site.download.macIntel, site.download.windows],
    "license": site.license,
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "CAD", "url": site.url + page.url + "#download" },
    "softwareHelp": { "@type": "WebPage", "url": site.url + "/" + loc.dir + "docs/" },
    "author": { "@type": "Person", "@id": site.repo + "#author", "name": site.author, "url": site.repo },
    "inLanguage": loc.htmlLang
  } %}
  <script type="application/ld+json">{{ app | jsonld | safe }}</script>
  {%- elif isDocs %}
  {% set home = site.url + "/" + loc.dir %}
  {% set guide = home + "docs/" %}
  {% set crumbs = [
    { "@type": "ListItem", "position": 1, "name": t.docs.home, "item": home },
    { "@type": "ListItem", "position": 2, "name": t.docs.title, "item": guide }
  ] %}
  {% if page.url != "/" + loc.dir + "docs/" %}
    {% set crumbs = crumbs.concat([{ "@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url }]) %}
  {% endif %}
  {% set breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs } %}
  <script type="application/ld+json">{{ breadcrumb | jsonld | safe }}</script>
  {%- endif %}
</head>
<body{% if isDocs %} class="is-docs"{% endif %}>
  <a class="skip" href="#content">{{ t.nav.skip }}</a>
  {% include "partials/header.njk" %}
  <main id="content" tabindex="-1">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/site.js' | bust }}" defer></script>
  {%- if not isDocs and not is404 %}
  <script src="{{ '/js/mocks.js' | bust }}" defer></script>
  {%- endif %}
</body>
</html>
