{% from "icons.njk" import logo %}
<footer class="site-foot">
  <div class="wrap foot-row">
    <span class="foot-brand">{{ logo(28) }}{{ site.name }}</span>
    <nav class="foot-links" aria-label="{{ t.footer.label }}">
      <a href="/{{ loc.dir }}docs/">{{ t.footer.guide }}</a>
      <a href="{{ site.releases }}">{{ t.footer.releases }}</a>
      <a href="{{ site.notices }}">{{ t.footer.notices }}</a>
      <a href="{{ site.repo }}">{{ t.footer.source }}</a>
      <a href="{{ site.license }}">{{ t.footer.license }}</a>
      <a href="{{ site.issues }}">{{ t.footer.support }}</a>
    </nav>
    <p class="foot-legal">{{ t.footer.notAffiliated }}<br>© {{ site.year }} · {{ t.footer.createdBy }} <a href="{{ site.authorUrl }}" rel="author">{{ site.author }}</a></p>
  </div>
</footer>
