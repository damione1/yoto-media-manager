---
permalink: _headers
eleventyExcludeFromCollections: true
---
/*
{%- for name, value in securityHeaders %}
  {{ name }}: {{ value | safe }}
{%- endfor %}

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/docs/images/*
  Cache-Control: public, max-age=604800
