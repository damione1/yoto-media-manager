{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoto-media-manager",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "yotomediamanager.app", "custom_domain": true },
    { "pattern": "www.yotomediamanager.app", "custom_domain": true },
    { "pattern": "yotomediamanager.damiengoehrig.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
